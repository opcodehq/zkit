{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zkit",
  "compatibility_date": "2026-10-27",
  "routes": [{ "pattern": "zkit.opcodehq.com", "custom_domain": true }],
  // A static site: Vite builds into dist/ and Workers serves it as assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
